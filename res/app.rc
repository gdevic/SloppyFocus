#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "version.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_APP ICON "app.ico"

IDR_TRAYMENU MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Enabled",      IDM_TRAY_TOGGLE
        MENUITEM SEPARATOR
        MENUITEM "&Settings...",  IDM_TRAY_SETTINGS
        MENUITEM "&About...",     IDM_TRAY_ABOUT
        MENUITEM SEPARATOR
        MENUITEM "E&xit",         IDM_TRAY_EXIT
    END
END

IDD_SETTINGS DIALOGEX 0, 0, 240, 178
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SloppyFocus"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    AUTOCHECKBOX    "Enable focus follows mouse",          IDC_CHK_ENABLED,         10,  10, 220, 12
    AUTOCHECKBOX    "Raise window to top on focus",        IDC_CHK_RAISE,           10,  26, 220, 12
    LTEXT           "Hover delay (ms):",                   -1,                      10,  46, 80,  10
    LTEXT           "200",                                 IDC_LBL_TIMEOUT,         95,  46, 40,  10
    CONTROL         "", IDC_TRK_TIMEOUT, "msctls_trackbar32",
                    TBS_AUTOTICKS | TBS_HORZ | WS_TABSTOP,
                    10,  60, 220, 24
    AUTOCHECKBOX    "Start with Windows",                  IDC_CHK_AUTOSTART,       10,  92, 220, 12
    AUTOCHECKBOX    "Disable focus follows mouse on exit", IDC_CHK_DISABLE_ON_EXIT, 10, 108, 220, 12
    DEFPUSHBUTTON   "OK",      IDOK,            70, 150, 50, 14
    PUSHBUTTON      "Cancel",  IDCANCEL,       125, 150, 50, 14
    PUSHBUTTON      "Apply",   IDC_BTN_APPLY,  180, 150, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_BUILD,0
 PRODUCTVERSION APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_BUILD,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS__WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Baltazar Studios, LLC"
            VALUE "FileDescription",  "SloppyFocus - focus follows mouse"
            VALUE "FileVersion",      APP_VERSION_STR4
            VALUE "InternalName",     APP_NAME
            VALUE "OriginalFilename", "SloppyFocus.exe"
            VALUE "ProductName",      APP_NAME
            VALUE "ProductVersion",   APP_VERSION_STR4
            VALUE "LegalCopyright",   APP_COPYRIGHT " " APP_LICENSE
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
